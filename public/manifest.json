{
  "manifest_version": 3,
  "name": "Upwork Proposal Pro v2.0",
  "version": "2.0.0",
  "description": "High-converting AI proposal generator & strategy workbench for Upwork freelancers.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Open Proposal Pro"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.upwork.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.upwork.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
